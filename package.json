{
  "name": "sample_match",
  "version": "1.0.0",
  "description": "ビジネスマッチングアプリ",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev:server": "nodemon server/server.js",
    "dev:client": "node client/server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:unit:coverage": "jest tests/unit --coverage --collectCoverageFrom='server/models/**/*.js'",
    "test:integration": "jest tests/integration",
    "test:ui": "jest tests/ui",
    "test:coverage": "jest --coverage --collectCoverageFrom='server/models/**/*.js'"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "html", "lcov", "json"],
    "collectCoverageFrom": [
      "server/models/**/*.js",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "body-parser": "^1.20.2",
    "jsonwebtoken": "^9.0.2"
  },  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "concurrently": "^8.2.2"
  }
}
